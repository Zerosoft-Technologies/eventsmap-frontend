rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userChatActive(uid) {
      let path = /databases/$(database)/documents/user_presence/$(uid);
      return !exists(path) || get(path).data.get('chat_active', true) != false;
    }

    function chatUsersBlocked(senderId, receiverId) {
      let blockBySender = /databases/$(database)/documents/chat_blocks/$(senderId)/users/$(receiverId);
      let blockByReceiver = /databases/$(database)/documents/chat_blocks/$(receiverId)/users/$(senderId);
      return exists(blockBySender) || exists(blockByReceiver);
    }

    // ── Presence (chatSidebar → setOnline / setOffline / setChatActive)
    match /user_presence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── Global DM: conversations/global_{min}_{max}
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && resource.data.participants != null
        && resource.data.participants.hasAny([int(request.auth.uid)]);

      allow create: if request.auth != null
        && request.resource.data.participants != null
        && request.resource.data.participants.hasAny([int(request.auth.uid)]);

      allow update: if request.auth != null
        && resource.data.participants != null
        && resource.data.participants.hasAny([int(request.auth.uid)]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
              .hasAny([int(request.auth.uid)]);

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
              .hasAny([int(request.auth.uid)])
          && request.resource.data.sender_id == int(request.auth.uid)
          && userChatActive(request.auth.uid)
          && userChatActive(string(request.resource.data.receiver_id))
          && !chatUsersBlocked(request.auth.uid, string(request.resource.data.receiver_id));

        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
              .hasAny([int(request.auth.uid)]);
      }
    }

    // ── Invitation notifications (backend writes; client reads)
    match /invitation_notifications/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.receiver_id
        || int(request.auth.uid) == resource.data.receiver_id
      );
      allow create, update, delete: if false;
    }

    // ── Chat blocks (backend sync; read-only for clients)
    match /chat_blocks/{blockerId}/users/{blockedId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else: implicit deny
  }
}
